
<ContentPage
    x:Class="ComparteYAyuda.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#FFFFFF"
    Title="ComparteYAyuda">

    <ScrollView>
        <VerticalStackLayout
            Padding="25,35"
            Spacing="20"
            VerticalOptions="Center">

            <Border
                BackgroundColor="#E8F3EF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24"
                Padding="20"
                HorizontalOptions="Center">
                <Label
                    Text="♡"
                    FontSize="55"
                    TextColor="#327A68"
                    HorizontalTextAlignment="Center"/>
            </Border>

            <Label
                Text="ComparteYAyuda"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#263B35"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Pequeñas acciones, grandes cambios."
                FontSize="17"
                TextColor="#64746D"
                HorizontalTextAlignment="Center"/>

            <BoxView
                HeightRequest="2"
                WidthRequest="65"
                Color="#327A68"
                HorizontalOptions="Center"/>

            <Label
                Text="¡Bienvenido!"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#263B35"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Comparte aquello que ya no necesitas y ayuda a quienes más lo necesitan. Una donación puede hacer la diferencia."
                FontSize="16"
                TextColor="#64746D"
                HorizontalTextAlignment="Center"/>

            <Button
                Text="Ver donaciones"
                BackgroundColor="#327A68"
                TextColor="#FFFFFF"
                FontAttributes="Bold"
                FontSize="17"
                CornerRadius="12"
                HeightRequest="55"
                Clicked="OnVerDonaciones"/>

            <Button
                Text="＋ Publicar donación"
                BackgroundColor="#E8F3EF"
                TextColor="#263B35"
                FontAttributes="Bold"
                FontSize="17"
                CornerRadius="12"
                HeightRequest="55"
                Clicked="OnPublicarDonacion"/>

            <Label
                Text="Juntos construimos una comunidad solidaria."
                FontSize="13"
                TextColor="#64746D"
                HorizontalTextAlignment="Center"
                Margin="0,15,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
